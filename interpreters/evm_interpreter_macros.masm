%macro deployer
    dataSize(sub_0)
    dataOffset(sub_0)
    0x00
    codecopy
    dataSize(sub_0)
    0x00
    return
    stop

    sub_0: assembly {
        %content
    }
%endmacro

%macro calld
    calldatasize
    0x00
    %0
    calldatacopy
%endmacro

%macro mreturn "return %0 %1"
    %1
    %0
    return
%endmacro

%macro mmstore "mstore %0 %1"
    %1
    %0
    mstore
%endmacro

%macro mmload "mload %0 %1"
    %1
    %0
    mload
%endmacro

%macro mfor_hc
    %1
    %0
    mstore
    %2
    `${'0x' + (%0 + 32).toString(16)}`
    mstore
     %3
    `${'0x' + (%0 + 64).toString(16)}`
    mstore
    for_%instance:
        `${'0x' + (%0 + 32).toString(16)}`
        mload
        %0
        mload
        lt
        forloop_%instance
        jumpi
        `${'0x' + (%0 + 64).toString(16)}`
        mload
        jump
    forloop_%instance:
        `${%content.replace(/%step/g, "%0 \n mload")}`
        %0
        mload
        0x01
        add
        %0
        mstore
        for_%instance
        jump
%endmacro

%macro mfor
    %0
    mstore   // store start
    `${'0x' + (%0 + 32).toString(16)}`
    mstore   // store end
    `${'0x' + (%0 + 64).toString(16)}`
    mstore   // store tag

    for_%instance:
        `${'0x' + (%0 + 32).toString(16)}`
        mload
        %0
        mload
        lt
        forloop_%instance
        jumpi
        `${'0x' + (%0 + 64).toString(16)}`
        mload
        jump
    forloop_%instance:
        `${%content.replace(/%step/g, "%0 \n mload")}`
        %0
        mload
        0x01
        add
        %0
        mstore
        for_%instance
        jump
%endmacro

%macrolist loadvals ","
    %x
    mload
%endmacrolist

%macro mrepeat
   ` ${%content.repeat(%0)}
   `
%endmacro

%macro let "let %0 := %1"
   ` let %0 := ${ %1 + this.vars.test }
   `
%endmacro

%macro wopcode
    %2:  // %0
        pop
        %1
        0xc0
        // push
        mload
        jump
        stop
%endmacro

%macro wopcode_push
    push%1_01:  // %0
        0xc0
        // push
        mload
        jump
        stop
        stop
        stop
%endmacro

%macro wopcode_dup
    dup%1_00:  // %0
        pop
        dup%1
        0xc0
        // push
        mload
        jump
        stop
%endmacro

%macro wopcode_swap
    swap%1_00:  // %0
        pop
        swap%1
        0xc0
        // push
        mload
        jump
        stop
%endmacro

%macro eopcode
    unused_%1:  // %0
        stop
        stop
        stop
        stop
        stop
        stop
        stop
%endmacro

%macro allocate
    %0
    mload
    swap1
    dup2
    add
    %0
    mstore
%endmacro
