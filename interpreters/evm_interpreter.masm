deployer {

    %macro wopcode
        %2:  // %0
            %1
            0xc0
            // push
            mload
            jump
            stop
            stop
    %endmacro

    %macro wopcode_push
        push%1_01:  // %0
            0x%1
            // push
            push_x_extra
            //
            // push2
            jump
            stop
    %endmacro

    %macro wopcode_dup
        dup%1_00:  // %0
            dup%1
            0xc0
            // push
            mload
            jump
            stop
            stop
    %endmacro

    %macro wopcode_swap
        swap%1_00:  // %0
            swap%1
            0xc0
            // push
            mload
            jump
            stop
            stop
    %endmacro

    %macro eopcode
        unused_%1:  // %0
            stop
            stop
            stop
            stop
            stop
            stop
            stop
    %endmacro

        // 0x60 free
        // 0x80 cache for tags
        // 0xa0 stop tag
        // 0xc0 return tag from compiled fns
        // 0x100 ptr to bytecode for evm interpreter (length is at - 32)
        // 0x120 ptr to calldata for evm interpreter (length is at - 32)
        // 0x140 mem offset for evm interpreter
        // 0x160 current data_ptr for evm interpreter - maybe this should be in the mem frame
        // 0x1a0 ptr to entire calldata - data_ptr : lengthB + bytecode + lengthC + calldata


        // !!! 0xa0 !!! start tag value - native functions
        mmstore 0xa0 stop_00


        // !!! 0xc0 !!! tag for returning from native function
        mmstore 0xc0 tag_2

        // !!! 0x100 !!! bytecode pointer - at data_ptr, after bytecode length
        0x1c0
        0x100
        mstore

        // !!! 0x120 !!! calldata pointer
        0x1c0              // bytecode start
        0x00
        calldataload       // add bytecode length
        add
        0x20
        add                // add 32 bytes for calldata length
        0x120
        mstore

        // !!! 0x140 !!! mem offset
        0x1a0              // after entire calldata
        calldatasize
        add
        0x140
        mstore

        // !!! 0x160 !!! current_data_ptr (bytecode)
        0x1c0
        0x160
        mstore

        // !!! 0x1a0 !!! copy entire calldata at data_ptr
        calldatasize
        0x00
        0x1a0
        calldatacopy

        tag_2:  // eval
          0x160    // current_data_ptr
          mload   // push data pointer on stack
          dup1    // data_ptr, data_ptr
          mload
          0xf8
          shr     // data_ptr, opcode
          0x01    // increment data_ptr
          dup3
          add
          swap2
          pop    // data_ptr, opcode

          swap1
          0x160    // current_data_ptr
          mstore   // opcode ; store data_ptr
          0x08
          mul
          0xa0
          mload
          add      // opcode_tag
          jump // in

         // we keep 4 instructions per function, for easy pc calculation
        stop_00:  // 0x00
            stop  // the following is not executed
            stop
            stop
            stop
            stop
            stop
            stop
        wopcode 0x01, add, add_21
        wopcode 0x02, mul, mul_21
        wopcode 0x03, sub, sub_21
        wopcode 0x04, div, div_21
        wopcode 0x05, sdiv, sdiv_21
        wopcode 0x06, mod, mod_21
        wopcode 0x07, smod, smod_21
        wopcode 0x08, addmod, addmod_31
        wopcode 0x09, mulmod, mulmod_31
        wopcode 0x0a, exp, exp_21
        wopcode 0x0b, signextend, signextend_21
        eopcode 0x0c, 1
