        wopcode_swap 0x90, 1
        wopcode_swap 0x91, 2
        wopcode_swap 0x92, 3
        wopcode_swap 0x93, 4
        wopcode_swap 0x94, 5
        wopcode_swap 0x95, 6
        wopcode_swap 0x96, 7
