deployer {

        %macro getfourb
            // expects a pointer
            mload
            0xe0
            shr
        %endmacro

        %macro geteightb
            // expects a pointer
            mload
            0xc0
            shr
        %endmacro

        %macro getfuncarity
            // expects a 4byte value
            0x3f
            and
        %endmacro

        %macro getfunclength
            // expects a 4byte value
            0xfffc00
            and
            0x0a
            shr
        %endmacro

        %macro getfuncloco
            // expects a 4byte value
            0x40
            and
            0x40
            eq   // returns 0 (stack) or 1 (memory)
        %endmacro

        %macro getrootid
            // expects a 32bytes value
            0xfc
            shr
        %endmacro

        %macro getframe
            0xe0
            mload
        %endmacro

        %macro getfncounter
            0x01
            sload
        %endmacro

        %macro addfncounter
            0x01
            sload
            0x01
            add
            0x01
            sstore
        %endmacro

        %macro getfnkey
            // expects fsig
            0x02    // seed
            0x00
            mstore

            0x20
            mstore

            0x40
            0x00
            sha3
        %endmacro

        %macro getnamehash
            // expects pointer to name (bytes)

            0x03    // seed
            0x00
            mstore

            // hash name first, so we don't need to copy the bytes
            dup1
            mload   // length
            swap1   // length, ptr
            sha3

            0x20
            mstore

            0x40
            0x00
            sha3
        %endmacro

        // GETTERS  //

        %macro getdataptr
            0x20
            add
            mload
        %endmacro

        %macro getenvptr
            0x40
            add
            mload
        %endmacro

        %macro getloco
            0x60
            add
            mload
        %endmacro

        %macro getpartialsptr
            0x80
            add
            mload
        %endmacro

        %macro getoutputptr
            0xa0
            add
            mload
        %endmacro

        %macro getforstep
            0xc0
            add
            mload
        %endmacro

        %macro getforend
            0xe0
            add
            mload
        %endmacro

        %macro getforreturn
            0x100
            add
            mload
        %endmacro

        %macro getreturn
            0x120
            add
            mload
        %endmacro

        %macro getdelmarker
            0x140
            add
            mload
        %endmacro

        // SETTERS  //

        %macro setdataptr
            0x20
            add
            mstore
        %endmacro

        %macro setenvptr
            0x40
            add
            mstore
        %endmacro

        %macro setloco
            0x60
            add
            mstore
        %endmacro

        %macro setpartialsptr
            0x80
            add
            mstore
        %endmacro

        %macro setoutputptr
            0xa0
            add
            mstore
        %endmacro

        %macro setforstep
            0xc0
            add
            mstore
        %endmacro

        %macro setforend
            0xe0
            add
            mstore
        %endmacro

        %macro setforreturn
            0x100
            add
            mstore
        %endmacro

        %macro setreturn
            0x120
            add
            mstore
        %endmacro

        %macro setdelmarker
            0x140
            add
            mstore
        %endmacro

        %macro dealloc_frame
            // expects frame ptr
            dup1
            0x140  // get del mark
            add
            mload
            keep_frame_%instance
            jumpi
            dup1  // just to keep stack balanced
            0x40
            mstore
            keep_frame_%instance:
                pop
        %endmacro

        %macro getsuperenv
            // frame_ptr, index
            getsuperenv_%instance  // frame_ptr, index, tag
            swap1                  // frame_ptr, tag, index
            0x00
            mfor_stack {
                // frame_ptr, tag, end, step
                dup4
                mload    // prev_frame_ptr
                swap4
                pop     // replace with prev_frame_ptr
            }
            getsuperenv_%instance:
                // last frame_ptr

                0x40   // get ptr env
                add
                mload
        %endmacro

        // start tag value - native functions
        mmstore 0xa0 stop_00

        // tag for returning from native function
        mmstore 0xc0 tag_eval

        // 0xe0 - current memory frame

        // copy input data in memory
        calld 0x100     // data_ptr

        // freeMemPtr
        0x100
        calldatasize
        add
        0x40
        mstore

        // prepare memory frame
        // TODO alloc mem frame before anything else, so we can dealloc everything once

        // MEMORY FRAME
        // 0x00 previous pointer
        // 0x20 data_ptr
        // 0x40 env_ptr
        // 0x60 0/1 memory or stack
        // 0x80 partials_ptr - t3 (depends on function arity)
        // 0xa0 output_ptr - pointer where to write the outputs one after another
        // 0xc0 for loop step number
        // 0xe0 for loop end
        // 0x100 for loop return tag
        // 0x120 eval return tag
        // 0x140 0/1 delete/don't delete

        // for stack we use: 0x00 - 0x40, 0xa0-0x120

        // MEMORY FRAME INIT
        0x160
        allocate 0x40

        // store current_frame_ptr
        dup1
        0xe0
        mstore

        // everything is 0 except:
        0x100   // data_ptr
        dup2
        setdataptr //

        tag_return    // return tag
        swap1
        setreturn  //

    tag_eval:
        getframe  //
        getdataptr //
        mload          // data
        getrootid      //

        dup1
        0x01
        eq
        eval_is_number
        jumpi

        dup1
        0x03
        eq
        eval_is_fn
        jumpi

        0x04
        eq
        eval_is_bytelike
        jumpi

    eval_end_processing:
            // current_frame_ptr, result_ptr, end_ptr on stack
            dup3
            getloco //

            0x01
            eq
            eval_end_processing_mem
            jumpi

            dup3      // current_frame_ptr, result_ptr, end_ptr, memframe_ptr
            getoutputptr  //
            mload  // actual output_ptr // current_frame_ptr, result_ptr, end_ptr, output_ptr

            0x20
            add
            mstore   // current_frame_ptr, result_ptr

            swap1 // frame, result_ptr -> result_ptr, frame

            getreturn  // load tag to jump from current frame
            jump
    eval_end_processing_mem:

            // current_frame_ptr, result_ptr, end_ptr on stack
            dup3      // current_frame_ptr, result_ptr, end_ptr, frame_ptr
            getoutputptr  //   current_frame_ptr, result_ptr, end_ptr, output_ptr
            mload  // actual output_ptr // current_frame_ptr, result_ptr, end_ptr, output_ptr

            swap1   // current_frame_ptr, result_ptr, output_ptr, end_ptr
            dup2    // current_frame_ptr, result_ptr, output_ptr, end_ptr, output_ptr

            0x20
            add     // current_frame_ptr, result_ptr, output_ptr, end_ptr, output_ptr
            mstore   // current_frame_ptr, result_ptr, output_ptr

            0x40
            add
            mstore   // current_frame_ptr

            getreturn  // load tag to jump from current frame
            jump

    tag_return:
        getframe  //
        getloco  //

        0x01
        eq
        tag_return_mem
        jumpi

        // answer is on stack
        0x00
        mstore
        0x20
        0x00
        return
    tag_return_mem:
        0x00           // here is output_ptr
        mload
        t3item_ 0x01   // result_ptr
        0x00
        mstore
        0x20
        0x00
        return

    eval_is_number:
            pop     // eval switch condition
            getframe //

            dup1
            getdataptr  //

            dup1    // get value - this is result_ptr
            0x04    // add 4bytes sig
            add
            mload   // result_ptr is value

            swap1       // data_ptr first
            0x24
            add        // end_ptr

            eval_end_processing   // current_frame_ptr, result_ptr, end_ptr on stack TODO should be macro
            jump

    eval_is_bytelike:
        getframe    //

        dup1
        getdataptr  // frame_ptr, data_ptr

        dup1        // frame_ptr, data_ptr, data_ptr
        0x04
        add
        getfourb    //  frame_ptr, data_ptr, bytes length

        dup1        //frame_ptr,  data_ptr, length, length
        0x20
        add
        allocate 0x40  // frame_ptr, data_ptr, length, result_ptr

        dup2    // frame_ptr, data_ptr, length, result_ptr, length
        dup2    // result_ptr
        mstore  // frame_ptr, data_ptr, length, result_ptr

        0x01
        dup5
        setdelmarker  // do not delete frame

        dup2    // length
        dup4     // source_ptr
        0x08
        add
        dup3     // target_ptr/result_ptr
        0x20
        add

        mmultimstore //

        dup3      // data_ptr
        0x08
        add
        dup3      // length
        add       // frame_ptr, data_ptr, length, result_ptr, data_ptr
        swap2     // frame_ptr, data_ptr, data_ptr, result_ptr, length
        pop       // frame_ptr, data_ptr, data_ptr, result_ptr
        swap2     // frame_ptr, result_ptr, data_ptr, data_ptr
        pop



        // current_frame_ptr, result_ptr, end_ptr
        eval_end_processing
        jump


    eval_is_fn:
        pop  // pop above switch condition
        getframe //

        dup1
        getdataptr  //

        dup1
        0x08
        add      // end_ptr

        dup2      // data_ptr
        getfourb  //
        dup1
        getfuncarity  //

        swap1
        getfuncloco  //
        dup5      // frame ptr
        setloco   //

        dup1       // arity - no of partials one for arity
        0x01
        add
        t3_init__ 0x40   // partials_ptr

        dup1      // partials_ptr
        0x20      // partial ptr to store new end_ptr and arity - fake partial
        add

        dup3   // arity is result_ptr
        dup5   // end_ptr
        0x02
        t3__ 0x40  // partial1
        swap1
        mstore     // store partial1

        dup1
        dup6    // frame ptr
        setpartialsptr  //

        // prealloc all partials output, so we can dealloc mem later

        // frame_ptr, data_ptr, end_ptr, arity, partial_ptr

        eval_is_fn_rest
        dup3
        0x00
        mfor_stack {
            // frame_ptr, data_ptr, end_ptr, arity, partial_ptr, tag, end, step
            0x02
            t3_init__ 0x40  //partial

            dup5   // partial_ptr
            dup3   // step
            0x20
            mul
            0x40
            add
            add
            mstore

        }
    eval_is_fn_rest:
        pop   // partial_ptr

        // remove stack except arity
        swap1
        pop
        swap1
        pop
        swap1
        pop

        eval_function_for_end   // arity, tag
        swap1   // tag, arity
        0x00   // start

        mfor_mem 0xe0, 0xc0 {      // step 457
            // create new memory frame
            // nothing on stack

            // step 499

            // MEMORY FRAME INIT  //
            0x160
            allocate 0x40

            getframe // prev_frame_ptr
            dup1
            dup3
            mstore  // PREV_PTR(0)

            // store current_frame_ptr
            dup2
            0xe0
            mstore

            dup1   // previous frame ptr is on stack
            getenvptr  //
            dup3    // new_frame_ptr
            setenvptr // ENV_PTR(2)  // TODO - more complex when we have let*

            dup1     // get mem/stack location from parent
            getloco  //
            dup3
            setloco  // MEM/STACK(3) //   if next is a function, it will set the mem/stack location itself

            dup1
            getpartialsptr  // from parent

            // new_frame_ptr, previous frame ptr, partials_ptr
            swap1       // new_frame_ptr, partials_ptr, previous frame ptr
            getforstep  // new_frame_ptr, partials_ptr, step
            0x02    // arity and first artificial partial
            add
            0x20
            mul     // partial ptr offset
            add     // partial ptr for this step -> output_ptr

            // new_frame_ptr, output_ptr
            dup1    // new_frame_ptr, output_ptr, output_ptr
            dup3    // new_frame_ptr, output_ptr, output_ptr, new_frame_ptr
            setoutputptr // OUTPUT_PTR(5) //  new_frame_ptr, output_ptr

            // take data ptr from previous partial
            0x20       // new_frame_ptr, output_ptr, 0x20
            swap1      // partial for this step
            sub       // previous partial
            mload
            t3item_ 0x00    // end_ptr is new data_ptr // new_frame_ptr, data_ptr

            dup2       // new_frame_ptr, data_ptr, new_frame_ptr
            setdataptr // DATA_PTR(1) //   new_frame_ptr

            0x00
            dup2
            setpartialsptr  // PARTIALS_PTR(4) empty
            0x00
            dup2
            setforstep      // LOOP START (6) empty
            0x00
            dup2
            setforend       // LOOP END (7) empty
            0x00
            dup2
            setforreturn    // LOOP RETURN (8) empty


            eval_function_for_content    // return tag
            swap1
            setreturn  // EVAL RETURN TAG(9)

            // END - MEMORY FRAME INIT  //

            // step 794 (nothing on stack)

            tag_eval
            jump

            eval_function_for_content:
                getframe  //

                mload     // get previous frame
                0xe0
                mstore
        }

    eval_function_for_end:
        getframe  //
        getloco  //

        0x01
        eq
        eval_function_for_end_mem
        jumpi

        getframe  //
        getdataptr //
        0x04
        add
        getfourb  //  function id fid

        0x00  // gets popped in eval_native_function

        eval_native_function
        jump

    test_tag:
        stop

    eval_function_for_end_mem:
        getframe  //

        dup1
        getdataptr //
        0x04
        add
        getfourb  //  function id fid  // frame_ptr, fid

        // get partials
        swap1   // current_frame_ptr should be parent frame
        getpartialsptr  // fid, partials_ptr

        dup1        // fid, partials_ptr, partials_ptr
        0x40        // partials without arity and fake first partial
        add         // fid, partials_ptr, actual_partials_start

        swap1    // arity - 1   // fid, actual_partials_start, partials_ptr
        mload    // fid, actual_partials_start, arity
        0x01     // fid, actual_partials_start, arity, 0x01
        swap1
        sub      // fid, actual_partials_start, actual_arity

        eval_native_function   // fid,  current_partial, arity, tag
        swap1  // fid, current_partial, tag, arity
        0x00
        mfor_stack {
            // fid, current_partial, tag, end, step
            dup4
            mload
            t3item_ 0x01   // result_ptr
            swap5
            swap4
            0x20
            add
            swap3
            swap2
            swap1
        }

    eval_native_function:
        pop
        // expects args, fid on stack

        eval_native_function_post
        0xc0
        mstore

        dup1  // native pop a value TODO better
        0x08  // instructions per opcode
        mul
        0xa0
        mload
        add
        jump
    eval_native_function_post:
        getframe //
        swap1

        dup2    // frame - get last partial for end_ptr
        getpartialsptr  //

        dup1
        mload   // arity
        0x20
        mul     // offset to last partial
        add
        mload
        t3item_ 0x00

         // current_frame_ptr, result_ptr, end_ptr on stack
        eval_end_processing
        jump




        // we keep 4 instructions per function, for easy pc calculation
        stop_00:  // 0x00
            stop  // the following is not executed
            stop
            stop
            stop
            stop
            stop
            stop
        wopcode 0x01, add, add_21
        wopcode 0x02, mul, mul_21
        wopcode 0x03, sub, sub_21
        wopcode 0x04, div, div_21
        wopcode 0x05, sdiv, sdiv_21
        wopcode 0x06, mod, mod_21
        wopcode 0x07, smod, smod_21
        wopcode 0x08, addmod, addmod_31
        wopcode 0x09, mulmod, mulmod_31
        wopcode 0x0a, exp, exp_21
        wopcode 0x0b, signextend, signextend_21
        eopcode 0x0c, 1
        eopcode 0x0d, 2
        eopcode 0x0e, 3
        eopcode 0x0f, 4
        wopcode 0x10, lt, lt_21
        wopcode 0x11, gt, gt_21
        wopcode 0x12, slt, slt_21
        wopcode 0x13, sgt, sgt_21
        wopcode 0x14, eq, eq_21
        wopcode 0x15, iszero, iszero_11
        wopcode 0x16, and, and_21
        wopcode 0x17, or, or_21
        wopcode 0x18, xor, xor_21
        wopcode 0x19, not, not_11
        wopcode 0x1a, byte, byte_21
        wopcode 0x1b, shl, shl_21
        wopcode 0x1c, shr, shr_21
        wopcode 0x1d, sar, sar_21
        eopcode 0x1e, 5
        eopcode 0x1f, 6
        wopcode 0x20, sha3, sha3_21
        eopcode 0x21, 7
        eopcode 0x22, 8
        eopcode 0x23, 9
        eopcode 0x24, 10
        eopcode 0x25, 11
        eopcode 0x26, 12
        eopcode 0x27, 13
        eopcode 0x28, 14
        eopcode 0x29, 15
        eopcode 0x2a, 16
        eopcode 0x2b, 17
        eopcode 0x2c, 18
        eopcode 0x2d, 19
        eopcode 0x2e, 20
        eopcode 0x2f, 21
        wopcode 0x30, address, address_01
        wopcode 0x31, balance, balance_11
        wopcode 0x32, origin, origin_01
        wopcode 0x33, caller, caller_01
        wopcode 0x34, callvalue, callvalue_01
        wopcode 0x35, calldataload, calldataload_11
        wopcode 0x36, calldatasize, calldatasize_01
        wopcode 0x37, calldatacopy, calldatacopy_30
        wopcode 0x38, codesize, codesize_01
        wopcode 0x39, codecopy, codecopy_30
        wopcode 0x3a, gasprice, gasprice_01
        wopcode 0x3b, extcodesize, extcodesize_11
        wopcode 0x3c, extcodecopy, extcodecopy_40
        wopcode 0x3d, returndatasize, returndatasize_01
        wopcode 0x3e, returndatacopy, returndatacopy_30
        wopcode 0x3f, extcodehash, extcodehash_11
        wopcode 0x40, blockhash, blockhash_11
        wopcode 0x41, coinbase, coinbase_01
        wopcode 0x42, timestamp, timestamp_01
        wopcode 0x43, number, number_01
        wopcode 0x44, difficulty, difficulty_01
        wopcode 0x45, gaslimit, gaslimit_01
        wopcode 0x46, stop, chainid_01
        wopcode 0x47, stop, selfbalance_01
        eopcode 0x48, 22
        eopcode 0x49, 23
        eopcode 0x4a, 24
        eopcode 0x4b, 25
        eopcode 0x4c, 26
        eopcode 0x4d, 27
        eopcode 0x4e, 28
        eopcode 0x4f, 29
        wopcode 0x50, pop, pop_00
        wopcode 0x51, mload, mload_11
        wopcode 0x52, mstore, mstore_20
        wopcode 0x53, mstore8, mstore8_20
        wopcode 0x54, sload, sload_11
        wopcode 0x55, sstore, sstore_20
        jump_10:  // 0x56
            pop
            jump_10_extra
            //
            // push2 ?
            jump
            stop
            stop
        jumpi_20:    // 0x57  // cond, new data_ptr, v0 -> dest, v0, cond, jump_10
            jumpi_20_extra
            //
            // push?
            jump
            stop
            stop
            stop
        wopcode 0x58, pc, pc_01
        wopcode 0x59, msize, msize_01
        wopcode 0x5a, gas, gas_01
        wopcode 0x5b, jumpdest, jumpdest_00
        eopcode 0x5c, 30
        eopcode 0x5d, 31
        eopcode 0x5e, 32
        eopcode 0x5f, 33
        wopcode_push 0x60, 1
        wopcode_push 0x61, 2
        wopcode_push 0x62, 3
        wopcode_push 0x63, 4
        wopcode_push 0x64, 5
        wopcode_push 0x65, 6
        wopcode_push 0x66, 7
        wopcode_push 0x67, 8
        wopcode_push 0x68, 9
        wopcode_push 0x69, 10
        wopcode_push 0x6a, 11
        wopcode_push 0x6b, 12
        wopcode_push 0x6c, 13
        wopcode_push 0x6d, 14
        wopcode_push 0x6e, 15
        wopcode_push 0x6f, 16
        wopcode_push 0x70, 17
        wopcode_push 0x71, 18
        wopcode_push 0x72, 19
        wopcode_push 0x73, 20
        wopcode_push 0x74, 21
        wopcode_push 0x75, 22
        wopcode_push 0x76, 23
        wopcode_push 0x77, 24
        wopcode_push 0x78, 25
        wopcode_push 0x79, 26
        wopcode_push 0x7a, 27
        wopcode_push 0x7b, 28
        wopcode_push 0x7c, 29
        wopcode_push 0x7d, 30
        wopcode_push 0x7e, 31
        wopcode_push 0x7f, 32
        wopcode_dup 0x80, 1
        wopcode_dup 0x81, 2
        wopcode_dup 0x82, 3
        wopcode_dup 0x83, 4
        wopcode_dup 0x84, 5
        wopcode_dup 0x85, 6
        wopcode_dup 0x86, 7
        wopcode_dup 0x87, 8
        wopcode_dup 0x88, 9
        wopcode_dup 0x89, 10
        wopcode_dup 0x8a, 11
        wopcode_dup 0x8b, 12
        wopcode_dup 0x8c, 13
        wopcode_dup 0x8d, 14
        wopcode_dup 0x8e, 15
        wopcode_dup 0x8f, 16
        wopcode_swap 0x90, 1
        wopcode_swap 0x91, 2
        wopcode_swap 0x92, 3
        wopcode_swap 0x93, 4
        wopcode_swap 0x94, 5
        wopcode_swap 0x95, 6
        wopcode_swap 0x96, 7
        wopcode_swap 0x97, 8
        wopcode_swap 0x98, 9
        wopcode_swap 0x99, 10
        wopcode_swap 0x9a, 11
        wopcode_swap 0x9b, 12
        wopcode_swap 0x9c, 13
        wopcode_swap 0x9d, 14
        wopcode_swap 0x9e, 15
        wopcode_swap 0x9f, 16
        wopcode 0xa0, log0, log0_20
        wopcode 0xa1, log1, log1_30
        wopcode 0xa2, log2, log2_40
        wopcode 0xa3, log3, log3_50
        wopcode 0xa4, log4, log4_60
        eopcode 0xa5, 34
        eopcode 0xa6, 35
        eopcode 0xa7, 36
        eopcode 0xa8, 37
        eopcode 0xa9, 38
        eopcode 0xaa, 39
        eopcode 0xab, 40
        eopcode 0xac, 41
        eopcode 0xad, 42
        eopcode 0xae, 43
        eopcode 0xaf, 44
        eopcode 0xb0, 45
        eopcode 0xb1, 46
        eopcode 0xb2, 47
        eopcode 0xb3, 48
        eopcode 0xb4, 49
        eopcode 0xb5, 50
        eopcode 0xb6, 51
        eopcode 0xb7, 52
        eopcode 0xb8, 53
        eopcode 0xb9, 54
        eopcode 0xba, 55
        eopcode 0xbb, 56
        eopcode 0xbc, 57
        eopcode 0xbd, 58
        eopcode 0xbe, 59
        eopcode 0xbf, 60
        eopcode 0xc0, 61
        log_2_11:  // 0xc1
            pop
            log_2_11_extra
            //
            // push
            jump
            stop
            stop
        log_11:  // 0xc2 // TODO fixme
            pop
            log_11_extra
            //
            // push
            jump
            stop
            stop
        sqrt_11:  // 0xc3
            pop
            sqrt_11_extra
            //
            // push
            jump
            stop
            stop
        nthroot_31:  // 0xc4
            pop
            nthroot_31_extra
            //
            // push
            jump
            stop
            stop
        factorial_11:  // 0xc5
